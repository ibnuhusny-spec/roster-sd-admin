<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@color/colorDarkBg</item>
        <item name="android:windowBackground">@color/colorDarkBg</item>
        <item name="android:colorBackground">@color/colorDarkBg</item>
        
        <!-- Fix Text Selection Context Menu (Paste/Copy/Select All Popup) -->
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#FDE047</item>
        <item name="android:colorBackgroundFloating">@color/colorSlate800</item>
        <item name="colorBackgroundFloating">@color/colorSlate800</item>
        <item name="actionMenuTextColor">#FFFFFF</item>
        <item name="android:textColorHighlight">#F59E0B66</item>
        <item name="android:colorControlNormal">#FFFFFF</item>
        <item name="android:colorControlActivated">#F59E0B</item>
        <item name="android:colorControlHighlight">#F59E0B66</item>
        
        <!-- Action Mode Floating Toolbar Styling -->
        <item name="actionModeStyle">@style/CustomActionMode</item>
        <item name="actionModeBackground">@color/colorSlate800</item>
        <item name="windowActionModeOverlay">true</item>
    </style>

    <style name="CustomActionMode" parent="Widget.AppCompat.ActionMode">
        <item name="background">@color/colorSlate800</item>
        <item name="titleTextStyle">@style/CustomActionModeTitle</item>
    </style>

    <style name="CustomActionModeTitle" parent="TextAppearance.AppCompat.Widget.ActionMode.Title">
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@color/colorDarkBg</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>